{
  "name": "@frostyard/lodge-client",
  "version": "0.3.0",
  "description": "The frame protocol between lodge's shell and its apps: the app half, the shell half, and the client of an app's API.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/frostyard/lodge.git", "directory": "client" },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./shell": { "types": "./src/shell.ts", "default": "./src/shell.ts" },
    "./rpc": { "types": "./src/rpc.ts", "default": "./src/rpc.ts" }
  },
  "files": ["src"],
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "check": "biome check . && tsc --noEmit && vitest run",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
