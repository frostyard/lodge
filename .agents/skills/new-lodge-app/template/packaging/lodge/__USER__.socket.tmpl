# __NAME__'s lodge socket (lodge's app-contract.md, Install layout). systemd
# creates it, owned by __USER__ and group lodge, 0660, and passes it to
# __ID__d, which the kit's lodgeapp.Env.Listen accepts.
[Unit]
Description=__NAME__'s lodge socket

[Socket]
ListenStream=/run/lodge/apps/__ID__.sock
FileDescriptorName=__ID__
SocketUser=__USER__
SocketGroup=lodge
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
