# __NAME__'s daemon, lodge's __ID__ app (lodge's app-contract.md). It runs as
# its own system user, in group lodge-apps for inference and never in
# group lodge, and listens on no network.
[Unit]
Description=__NAME__, behind lodge
Requires=__USER__.socket
After=__USER__.socket

[Service]
Type=exec
User=__USER__
Group=__USER__
SupplementaryGroups=lodge-apps
ExecStart=/usr/bin/__ID__d
StateDirectory=__USER__
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
