{
  "name": "@frostyard/lodge-ui",
  "version": "0.2.0",
  "description": "lodge's shared look: the design tokens, the Tailwind theme over them, and the React primitives that frostmail, frostnotes and frostread share.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/frostyard/lodge.git", "directory": "ui" },
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./accents.css": "./src/accents.css",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./fonts.css": "./src/fonts.css",
    "./theme": { "types": "./src/theme.ts", "default": "./src/theme.ts" },
    "./react": { "types": "./src/react/index.ts", "default": "./src/react/index.ts" }
  },
  "files": ["src"],
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "check": "biome check . && tsc --noEmit && vitest run",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "lucide-react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
